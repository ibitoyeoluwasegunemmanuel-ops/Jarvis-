{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal permissions for the JARVIS main window. The gateway sidecar is restricted to fixed loopback arguments and is started only by native Rust code.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/jarvis-gateway",
          "sidecar": true,
          "args": ["--host", "127.0.0.1", "--port", "8765"]
        }
      ]
    }
  ]
}
